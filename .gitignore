# ==============================================================================
# Git Ignore Configuration for Government AI Data Intelligence Platform
# ==============================================================================

# Sensitive credentials & environment files
.env
.env.local
.env.*.local

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments & Conda
venv/
env/
.venv/
conda-env/
.conda/

# IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Temporary logs & databases
*.log
scratch/

# Generated HTML reports (sample report included in repo)
# data/reports/*.html

# Internal patch/migration scripts
scripts/_patch_*.py

# ETL validation output (generated at runtime)
data/validation/
