# ==============================================================================
# Git Ignore Configuration for Government AI Data Intelligence Platform
# ==============================================================================

# Sensitive credentials & environment files
.env
.env.local
.env.*.local

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
env/
.venv/
conda-env/

# IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Temporary logs & databases
*.log
scratch/
